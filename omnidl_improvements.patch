+Design principles
+─────────────────
+• Runs ffmpeg in a subprocess on a daemon thread — never blocks the UI.
+• Uses utils.ffmpeg_locator to find ffmpeg regardless of platform or
+  bundle mode (PyInstaller / source / system PATH).
+• All paths are pathlib.Path objects; no hardcoded separators.
+• Output is written to ``<input_stem>_converted.mp4`` alongside the
+  source file so the original is never overwritten.
+• Progress is reported as a float 0.0–100.0 via an optional callback.
+• On completion or failure the ``on_done`` / ``on_error`` callback fires
+  on the same background thread — callers in the UI layer must marshal
+  to the main thread via ``widget.after(0, fn)``.
+
+Target format (fixed):
+  container : MP4
+  video     : H.264 (libx264), preset fast, CRF 22
+  audio     : AAC 192 kbps
+  pixel fmt : yuv420p   (guarantees broad player compatibility)
+"""
+from __future__ import annotations
+
+import logging
+import re
+import subprocess
+import threading
+from pathlib import Path
+from typing import Callable, Optional
+
+from utils.ffmpeg_locator import locate_ffmpeg
+
+logger = logging.getLogger(__name__)
+
+# Regex that parses the ``time=HH:MM:SS.cc`` field from ffmpeg's stderr.
+_TIME_RE = re.compile(r"time=(\d+):(\d+):(\d+)\.(\d+)")
+
+
+def _parse_seconds(match: re.Match) -> float:
+    h, m, s, cs = (int(g) for g in match.groups())
+    return h * 3600 + m * 60 + s + cs / 100.0
+
+
+class ConversionError(RuntimeError):
+    """Raised when ffmpeg exits with a non-zero return code."""
+
+
+class FfmpegConvertService:
+    """
+    Converts a single video file to MP4/H.264/AAC in a background thread.
+
+    Usage::
+
+        svc = FfmpegConvertService()
+        svc.convert(
+            source=Path("video.webm"),
+            on_progress=lambda pct: ...,   # float 0–100
+            on_done=lambda out: ...,        # Path to output file
+            on_error=lambda msg: ...,       # str error message
+        )
+    """
+
+    # ── Public API ────────────────────────────────────────────────────────
+
+    def convert(
+        self,
+        source: Path,
+        on_progress: Optional[Callable[[float], None]] = None,
+        on_done: Optional[Callable[[Path], None]] = None,
+        on_error: Optional[Callable[[str], None]] = None,
+    ) -> None:
+        """
+        Start a background conversion of *source* to MP4.
+
+        The output file is placed next to the source:
+            ``<stem>_converted.mp4``
+
+        All callbacks fire on the worker thread; the UI must use
+        ``widget.after(0, lambda: ...)`` to marshal to the main thread.
+        """
+        thread = threading.Thread(
+            target=self._run,
+            args=(source, on_progress, on_done, on_error),
+            daemon=True,
+            name=f"omnidl-convert-{source.stem[:20]}",
+        )
+        thread.start()
+
+    # ── Internal ──────────────────────────────────────────────────────────
+
+    def _run(
+        self,
+        source: Path,
+        on_progress: Optional[Callable[[float], None]],
+        on_done: Optional[Callable[[Path], None]],
+        on_error: Optional[Callable[[str], None]],
+    ) -> None:
+        try:
+            output = self._convert_sync(source, on_progress)
+            if on_done:
+                on_done(output)
+        except Exception as exc:
+            logger.error("Conversion failed for %s: %s", source, exc)
+            if on_error:
+                on_error(str(exc))
+
+    def _convert_sync(
+        self,
+        source: Path,
+        on_progress: Optional[Callable[[float], None]],
+    ) -> Path:
+        """Blocking conversion — call from background thread only."""
+        if not source.is_file():
+            raise ConversionError(f"Source file not found: {source}")
+
+        ffmpeg_bin = self._locate_ffmpeg_bin()
+
+        output = source.with_name(source.stem + "_converted.mp4")
+        # Never silently overwrite an existing conversion result.
+        if output.exists():
+            i = 2
+            while True:
+                candidate = source.with_name(
+                    f"{source.stem}_converted_{i}.mp4"
+                )
+                if not candidate.exists():
+                    output = candidate
+                    break
+                i += 1
+
+        # Measure total duration for progress calculation.
+        duration_s = self._probe_duration(ffmpeg_bin, source)
+
+        cmd = [
+            str(ffmpeg_bin),
+            "-y",                        # overwrite handled above; -y for temp
+            "-i", str(source),
+            "-c:v", "libx264",
+            "-preset", "fast",
+            "-crf", "22",
+            "-pix_fmt", "yuv420p",
+            "-c:a", "aac",
+            "-b:a", "192k",
+            "-movflags", "+faststart",   # web-optimised — moov atom at front
+            str(output),
+        ]
+
+        logger.info("Starting conversion: %s → %s", source.name, output.name)
+        logger.debug("ffmpeg command: %s", " ".join(cmd))
+
+        proc = subprocess.Popen(
+            cmd,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            # Never use shell=True — avoids shell-injection via file paths.
+        )
+
+        # ffmpeg writes progress to stderr.  Read it line-by-line so we can
+        # parse ``time=`` without buffering the entire output in memory.
+        stderr_lines: list[str] = []
+        assert proc.stderr is not None
+        for raw_line in proc.stderr:
+            line = raw_line.decode("utf-8", errors="replace").rstrip()
+            stderr_lines.append(line)
+            if on_progress and duration_s > 0:
+                m = _TIME_RE.search(line)
+                if m:
+                    elapsed = _parse_seconds(m)
+                    pct = min(99.0, elapsed / duration_s * 100.0)
+                    on_progress(pct)
+
+        proc.wait()
+
+        if proc.returncode != 0:
+            tail = "\n".join(stderr_lines[-8:])
+            raise ConversionError(
+                f"ffmpeg exited with code {proc.returncode}.\n{tail}"
+            )
+
+        if not output.is_file() or output.stat().st_size < 1_000:
+            raise ConversionError(
+                f"Output file missing or empty after conversion: {output}"
+            )
+
+        logger.info(
+            "Conversion complete: %s (%.1f MB)",
+            output.name,
+            output.stat().st_size / 1_048_576,
+        )
+        if on_progress:
+            on_progress(100.0)
+        return output
+
+    # ── Helpers ───────────────────────────────────────────────────────────
+
+    @staticmethod
+    def _locate_ffmpeg_bin() -> Path:
+        """Return the absolute path to the ffmpeg binary, or raise."""
+        loc = locate_ffmpeg()
+        if loc is None:
+            raise ConversionError(
+                "FFmpeg not found.  Install FFmpeg via your OS package manager\n"
+                "or rebuild the OmniDL bundle with FFmpeg staged in resources/ffmpeg/."
+            )
+        # ffmpeg_bin is always a string resolved by ffmpeg_locator.
+        return Path(loc.ffmpeg_bin)
+
+    @staticmethod
+    def _probe_duration(ffmpeg_bin: Path, source: Path) -> float:
+        """Return the video duration in seconds, or 0.0 if it cannot be read."""
+        try:
+            result = subprocess.run(
+                [
+                    str(ffmpeg_bin),
+                    "-i", str(source),
+                ],
+                capture_output=True,
+                timeout=10,
+            )
+            # ffmpeg writes duration to stderr even on "error" (no output spec).
+            text = result.stderr.decode("utf-8", errors="replace")
+            m = re.search(
+                r"Duration:\s*(\d+):(\d+):(\d+)\.(\d+)", text
+            )
+            if m:
+                return _parse_seconds(m)
+        except Exception as exc:
+            logger.debug("Duration probe failed: %s", exc)
+        return 0.0
