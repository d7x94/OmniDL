+            card.pack(side="left", padx=(0, 8))
+            self._quality_cards[key] = card
+
+        # Output folder row
+        out_row = ctk.CTkFrame(cfg, fg_color="transparent")
+        out_row.pack(fill="x", padx=20, pady=(4, 16))
